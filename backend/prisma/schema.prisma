datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  pin_hash     String
  role         String     // "admin" | "cashier"
  full_name    String
  sub_text     String
  is_active    Boolean    @default(true)
  auto_lock    String     @default("2 min")
  schedule_json String?
  phase_access Int        @default(2) // 1 = Phase 1 features only, 2 = Phase 1 + Phase 2 (applies to admins)
  active_counter String?  // billing counter the user is currently working on (CashCounter.counter_name)
  on_leave     Boolean    @default(false)
  leave_reason String?
  leave_started_at DateTime?
  email        String?    // business accounts (HO Admin): email + password sign-in; PIN users leave these empty
  password_hash String?
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  sales        Sale[]
  returns      SaleReturn[]
  held_bills   HeldBill[]
  audit_logs   AuditLog[]
  modules_json         String?    // per-user module access overrides (JSON {module: true|false}); empty = the role's defaults
}

model Customer {
  id            String   @id           // CUST-0001
  name          String
  mobile        String   @unique
  email         String?
  address       String?
  customer_type String   @default("Retail") // "Retail" | "Wholesale"
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model CashCounter {
  id            String   @id @default(uuid())
  counter_name  String   @unique
  opening_float Float    @default(2000.0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model Category {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
}

model Item {
  sku                 String   @id
  barcode             String
  name                String
  category_name       String
  price               Float
  wholesale_price     Float?
  cost_price          Float    @default(0.0)
  landed_cost         Float    @default(0.0)
  tax_rate            Float
  stock               Float
  min_stock           Float    @default(10.0)
  pricing_method      String   @default("qty") // "qty" | "weight"
  unit                String   @default("pcs") // "pcs" | "kg"
  preferred_vendor_id String?
  mfg_date            DateTime?
  exp_date            DateTime?
  batch_no            String?
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model Vendor {
  id               String           @id
  name             String
  category         String
  contact          String
  phone            String
  email            String
  terms            String           // "Net 15", "Net 30", "Net 45", "Net 7", "Due on Delivery"
  status           String           @default("Active") // "Active" | "Inactive"
  payable          Float            @default(0.0)
  gstin            String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  purchase_orders  PurchaseOrder[]
  goods_receipts   GoodsReceiptNote[]
  purchase_returns PurchaseReturn[]
  vendor_payments  VendorPayment[]
}

model PurchaseOrder {
  id             String              @id
  vendor_id      String
  vendor         Vendor              @relation(fields: [vendor_id], references: [id])
  date           String
  expected       String
  status         String              @default("Pending") // "Draft", "Pending", "Approved", "Ordered", "Partially Received", "Received", "Cancelled" (older rows may still say "Pending Approval" / "Closed")
  approved_by    String?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  lines          PurchaseOrderLine[]
  goods_receipts GoodsReceiptNote[]
}

model PurchaseOrderLine {
  id           String        @id @default(uuid())
  po_id        String
  po           PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  sku          String
  name         String
  ordered_qty  Float
  received_qty Float         @default(0.0)
  cost         Float
  tax_rate     Float         @default(0.0)   // GST % on this line
  batch_no     String?
}

model GoodsReceiptNote {
  id                    String                 @id
  po_id                 String?
  po                    PurchaseOrder?         @relation(fields: [po_id], references: [id])
  vendor_id             String
  vendor                Vendor                 @relation(fields: [vendor_id], references: [id])
  date                  String
  total                 Float
  landed_cost_allocation Float                 @default(0.0)
  created_at            DateTime               @default(now())
  lines                 GoodsReceiptNoteLine[]
}

model GoodsReceiptNoteLine {
  id     String           @id @default(uuid())
  grn_id String
  grn    GoodsReceiptNote @relation(fields: [grn_id], references: [id], onDelete: Cascade)
  sku    String
  name   String
  qty    Float
  cost   Float
  tax_rate Float          @default(0.0)
}

model PurchaseReturn {
  id         String               @id // Debit note ID e.g. DN-1001
  vendor_id  String
  vendor     Vendor               @relation(fields: [vendor_id], references: [id])
  date       String
  reason     String
  total      Float
  invoice_id String?              // purchase invoice the goods are returned against: a GRN id (or a PO id)
  po_id      String?              // purchase order the returned goods came from
  status     String               @default("Processed") // "Draft" | "Processed"
  created_at DateTime             @default(now())
  lines      PurchaseReturnLine[]
}

model PurchaseReturnLine {
  id            String         @id @default(uuid())
  return_id     String
  return_record PurchaseReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  sku           String
  name          String
  qty           Float
  cost          Float
  tax_rate      Float          @default(0.0)
}

model VendorPayment {
  id         String   @id // e.g. PMT-1001
  vendor_id  String
  vendor     Vendor   @relation(fields: [vendor_id], references: [id])
  date       String
  amount     Float
  mode       String   // "Bank Transfer", "Cheque", "UPI", "Cash"
  reference  String?  // cheque / UTR / transaction number
  created_at DateTime @default(now())
}

model StockAdjustment {
  id          String   @id // e.g. ADJ-0091
  sku         String
  name        String
  delta       Float
  reason      String
  notes       String?
  approved_by String
  date        String
  created_at  DateTime @default(now())
}

model Batch {
  id          String   @id @default(uuid())
  sku         String
  name        String
  batch_no    String
  mfg_date    String
  expiry_date String
  qty         Float
  created_at  DateTime @default(now())
}

model Discount {
  id           String    @id @default(uuid())
  name         String
  type         String    // "percent" | "flat"
  value        Float
  applies_to   String    // "all" | "selected"
  product_skus String    @default("[]") // JSON string of SKUs
  start_date   String?
  end_date     String?
  status       String    @default("active") // "active" | "inactive"
  created_at   DateTime  @default(now())
}

model Sale {
  id                    String       @id @default(uuid())
  invoice_no            String       @unique
  counter_name          String?
  customer_id           String?
  customer_name         String?
  created_by_username   String
  created_by            User         @relation(fields: [created_by_username], references: [username])
  time                  DateTime     @default(now())
  pricing_mode          String       @default("exclusive") // "exclusive" | "inclusive"
  subtotal_original     Float
  auto_discount_total   Float
  manual_discount_total Float
  discount_total        Float
  taxable_total         Float
  gst_total             Float
  grand_total           Float
  status                String       @default("COMPLETED") // "COMPLETED" | "RETURNED" | "PARTIALLY_RETURNED"
  created_at            DateTime     @default(now())
  items                 SaleItem[]
  tenders               SaleTender[]
  returns               SaleReturn[]
}

model SaleItem {
  id               String   @id @default(uuid())
  sale_id          String
  sale             Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  sku              String
  name             String
  price            Float
  tax_rate         Float
  qty              Float
  unit             String
  pricing_method   String
  original_amount  Float
  discount_amount  Float
  discount_name    String?
  taxable_amount   Float
  gst_amount       Float
  final_amount     Float
}

model SaleTender {
  id      String @id @default(uuid())
  sale_id String
  sale    Sale   @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  mode    String // "Cash" | "Card" | "UPI"
  amount  Float
}

model SaleReturn {
  id                  String       @id @default(uuid())
  return_no           String       @unique
  invoice_no          String
  sale_id             String
  sale                Sale         @relation(fields: [sale_id], references: [id])
  created_by_username String
  created_by          User         @relation(fields: [created_by_username], references: [username])
  time                DateTime     @default(now())
  total_refund        Float
  reason              String?
  items               ReturnItem[]
  created_at          DateTime     @default(now())
}

model ReturnItem {
  id            String     @id @default(uuid())
  return_id     String
  return_record SaleReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  sku           String
  qty           Float
  refund_amount Float
  action        String     @default("Return")   // Return | Exchange (what the store allows is set in Store Settings)
  condition     String     @default("Good")     // Good | Damaged | Warranty (set by the cashier)
  reason        String?                         // optional per-item return reason (Customer Return / Damaged / Not Willing / Warranty / Other: text)
  review_status String?                         // Damaged / Warranty items: PENDING until an Admin resolves them, then RESOLVED
  review_outcome String?
  review_notes  String?
  reviewed_by   String?
  reviewed_at   DateTime?
  stock_delta   Float?                          // stock added back when the Admin resolved the item
}

model HeldBill {
  id                  String   @id @default(uuid())
  held_id             String   @unique
  created_by_username String
  created_by          User     @relation(fields: [created_by_username], references: [username])
  time                DateTime @default(now())
  lines_json          String
  discount_json       String
  item_count          Float
  total               Float
  created_at          DateTime @default(now())
}

model StoreSettings {
  id                   String   @id @default("store_main")
  store_name           String   @default("Okuto Mart")
  address              String   @default("12, MG Road, Bengaluru")
  phone                String   @default("+91 98765 43210")
  gstin                String   @default("29ABCDE1234F1Z5")
  pricing_mode         String   @default("exclusive")
  idle_timeout_seconds Int      @default(45)
  return_policy        String   @default("BOTH")   // allowed customer-return action: RETURN | EXCHANGE | BOTH
  updated_at           DateTime @updatedAt
}

/// GST tax slabs offered when pricing an item (Tax Configuration). An item stores the slab's rate, not the slab.
model TaxSlab {
  id         String   @id @default(uuid())
  name       String
  rate       Float    @unique
  created_at DateTime @default(now())
}

/// OKUTO IQ chatbot add-on subscription (single row). Removing it only clears this row; no other data is touched.
model OkutoIqSubscription {
  id           String    @id @default("okuto_iq")
  status       String    @default("inactive")
  started_at   DateTime?
  expires_at   DateTime?
  activated_by String?
  updated_at   DateTime  @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  username     String
  user         User     @relation(fields: [username], references: [username])
  action       String
  details_json String?
  timestamp    DateTime @default(now())
}


// =====================================================================================================
// Platform / multi-tenant control plane (Super Admin). These tables live in the default schema and are
// only ever read through `control_db`; tenant data lives in each tenant's own PostgreSQL schema.
// =====================================================================================================

/// One business using the platform. The original single store is the default tenant (schema_name = "public").
model Tenant {
  id                    String   @id @default(uuid())
  code                  String   @unique          // business code used to sign in with a PIN, e.g. "abc-supermarket"
  name                  String                    // tenant_name
  legal_name            String
  owner_name            String
  email                 String
  phone                 String
  address               String
  city                  String
  state                 String
  country               String   @default("India")
  postal_code           String
  gstin                 String
  business_type         String
  initial_outlet_name   String?                   // used as the store name of the tenant's StoreSettings
  status                String   @default("INVITED")  // PENDING_APPROVAL..INVITATION_EXPIRED (see superadmin.md)
  status_before_suspend String?
  schema_name           String   @unique          // PostgreSQL schema holding this tenant's data
  is_default            Boolean  @default(false)
  provision_status      String   @default("pending")  // pending | ready | failed
  schema_version        Int      @default(0)          // application tables version of this tenant's schema (see tenancy.SCHEMA_VERSION)
  provision_error       String?
  request_id            String?
  created_by            String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  subscription          TenantSubscription?
  invitations           TenantInvitation[]
}

model TenantSubscription {
  id                      String    @id @default(uuid())
  tenant_id               String    @unique
  tenant                  Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  plan_id                 String?
  current_plan            String    @default("Trial")
  trial_start_date        DateTime?
  trial_end_date          DateTime?
  trial_duration_days     Int       @default(14)
  subscription_start_date DateTime?
  subscription_end_date   DateTime?
  payment_status          String    @default("NOT_PAID")  // NOT_PAID | PENDING | PAID | FAILED
  pending_plan_id         String?                         // plan chosen at checkout, activated once payment is verified
  trial_reminder_sent     Boolean   @default(false)
  updated_at              DateTime  @updatedAt
}

model SubscriptionPlan {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?
  price          Float    @default(0)
  currency       String   @default("INR")
  duration_days  Int      @default(30)
  max_users      Int?
  storage_mb     Int?
  ai_enabled     Boolean  @default(false)
  reports_enabled Boolean @default(true)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

/// A business asking to join (future public website, or created by Super Admin review flow).
model TenantRequest {
  id                  String    @id @default(uuid())
  tenant_name         String
  legal_name          String
  owner_name          String
  email               String
  phone               String
  address             String
  city                String
  state               String
  country             String    @default("India")
  postal_code         String
  gstin               String
  business_type       String
  initial_outlet_name String?
  notes               String?
  source              String    @default("website")
  status              String    @default("PENDING_APPROVAL")  // PENDING_APPROVAL | APPROVED | REJECTED
  reviewed_by         String?
  reviewed_at         DateTime?
  reject_reason       String?
  tenant_id           String?
  ip_address          String?
  created_at          DateTime  @default(now())
}

/// Single-use invitation / password-reset token. Only the SHA-256 hash of the token is stored.
model TenantInvitation {
  id          String    @id @default(uuid())
  tenant_id   String
  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  email       String
  token_hash  String    @unique
  purpose     String    @default("invite")   // invite | password_reset
  status      String    @default("PENDING")  // PENDING | ACCEPTED | EXPIRED | REVOKED
  expires_at  DateTime
  used_at     DateTime?
  accepted_at DateTime?
  created_by  String?
  created_at  DateTime  @default(now())
}

/// The platform administrator(s). Not bound to any tenant.
model PlatformUser {
  id            String    @id @default(uuid())
  email         String    @unique
  full_name     String
  password_hash String
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model TenantNotification {
  id         String   @id @default(uuid())
  audience   String                         // super_admin | tenant
  tenant_id  String?
  type       String
  title      String
  message    String
  link       String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}

model PlatformAuditLog {
  id            String   @id @default(uuid())
  actor_id      String?
  actor_role    String
  actor_email   String?
  tenant_id     String?
  action        String
  ip_address    String?
  metadata_json String?
  timestamp     DateTime @default(now())
}

model PlatformSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}
